<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>CustomSoundboard</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Custom Soundboard</ApplicationTitle>
    <ApplicationId>uk.co.dbak91.customsoundboard</ApplicationId>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" Version="1.13.8" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-x64" Version="1.13.8" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.7" Color="#1E3A5F" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <!--
    Symbol packs (Mulberry, OpenMoji) tiles can use. One 384px WebP per symbol, loaded as symbols/<name>.webp.
    As MauiImages they would be packed at five screen sizes each, which made 173 symbols take 22.7 MB.
    All 3,087 are packaged.
  -->
  <ItemGroup>
    <MauiAsset Include="Resources\Packs\Full\*.webp" LogicalName="symbols/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The two British AI voices (Piper): Sonia (jenny_dioco) and a male voice (alan). Unpacked to app storage on first use as voices/<file>. -->
  <ItemGroup>
    <MauiAsset Include="Resources\Voices\*.onnx;Resources\Voices\*-tokens.txt;Resources\Voices\espeak-ng-data.zip" LogicalName="voices/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sound files are loaded at runtime with FileSystem.OpenAppPackageFileAsync("sounds/<file>"). -->
    <MauiAsset Include="Resources\Sounds\*.wav" LogicalName="sounds/%(Filename)%(Extension)" />
    <MauiAsset Include="Resources\Sounds\*.mp3" LogicalName="sounds/%(Filename)%(Extension)" />
    <MauiAsset Include="Resources\Sounds\*.m4a" LogicalName="sounds/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <Import Project="release-signing\CustomSoundboard.signing.props" Condition="Exists('release-signing\CustomSoundboard.signing.props')" />

</Project>
